---
import BaseLayout from "./BaseLayout.astro";
import CTA from "@components/CTA-51/cta-51.astro";
import Banner849 from "@components/Banner-849/banner-849.astro";
import {} from "@assets/index";
import { images } from "assets"; // Demo images, remove from final site and replace with src images
import client from "@data/client.json"

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;

const niche = client.industry.service.toLowerCase();
---

<BaseLayout title={title} description={description}>
  <Banner849
    title={heading}
    src={images[niche].banner}
    alt="dining room"
    align="center"
  />
  <slot />
  <CTA
    topper="Contact Us"
    title="Get It Done With Us Today"
    text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quis at sit pellentesque molestie.  Diam, adipiscing ultrices eu turpis gravida."
    href=""
    ariaLabel="quote"
    buttonText="Get A Free Quote"
    src={images[niche].cta}
    alt="cabinets"
  />
</BaseLayout>
