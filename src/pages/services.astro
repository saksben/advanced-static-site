---
import {} from "@assets/index";
import { images } from "assets"; // Demo images, remove from final site and replace with src images
import Banner849 from "@components/Banner-849/banner-849.astro";
import CsButton1 from "@components/Buttons/Button-1/cs-button-1.astro";
import ContentPage713 from "@components/ContentPage-713/content-page-713.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { capitalize, cn } from "@utils/utils";
import client from "@data/client.json";
import PaintingService from "@components/ServicesPage/PaintingService.astro";
import PlumbingService from "@components/ServicesPage/PlumbingService.astro";
import RoofingService from "@components/ServicesPage/RoofingService.astro";
import LandscapingService from "@components/ServicesPage/LandscapingService.astro";

let service = client.industry.service;

const niche = client.industry.service.toLowerCase();
---

<BaseLayout title="Services" description="">
  <Banner849 title="Services" alt="dining room" src={images[niche].banner} align="center" />
  <ContentPage713 alt="person smiling" src={images[niche].services}>
    {
      service === "plumbing" ? (
        <PlumbingService />
      ) : service === "roofing" ? (
        <RoofingService />
      ) : service === "painting" ? (
        <PaintingService />
      ) : service === "landscaping" ? (
        <LandscapingService />
      ) : (
        ""
      )
    }
    <CsButton1
      text="Get an Estimate"
      ariaLabel="Get an estimate"
      href="/contact"
    />
  </ContentPage713>
</BaseLayout>
