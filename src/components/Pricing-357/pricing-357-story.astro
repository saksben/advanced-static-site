---
import { cn, pluralize } from "@utils/utils";
import Pricing357 from "./pricing-357.astro";
import Pricing357Section from "./pricing-357-section.astro";
import Pricing357Item from "./pricing-357-item.astro";
import Pricing357Li from "./pricing-357-li.astro";
import client from "@data/client.json"

interface Props {}

const {} = Astro.props;

// Styles
---

<Pricing357Section
  topper="Pricing"
  title="It\’s Easy to Get Started"
  text=`At ${client.name}, let us help you solve problems so that you can ${client.industry.sector === "residential" ? "have peace of mind" : "focus on your mission"}. We support ${pluralize(client.industry.entity)} through periods of entry and expansion.`
>
  <Pricing357>
    <Pricing357Item
      title="Starter"
      desc="Perfect to get started"
      price="$249"
      rate="/month"
      href="/contact"
      ariaLabel=""
      buttonText="Get Started"
    >
      <Pricing357Li text="All available starter feature" />
      <Pricing357Li text="Home service 24/7" />
      <Pricing357Li disabled text="Customer agent service" />
      <Pricing357Li disabled text="Professional cleaner" />
      <Pricing357Li disabled text="Extra testing" />
      <Pricing357Li disabled text="Certificate" />
    </Pricing357Item>
    <Pricing357Item
      title="Professional"
      desc="A little more"
      price="$999"
      rate="/month"
      popular
      href="/contact"
      ariaLabel=""
      buttonText="Get Started"
    >
      <Pricing357Li text="All available starter feature" />
      <Pricing357Li text="Home service 24/7" />
      <Pricing357Li text="Customer agent service" />
      <Pricing357Li text="Professional cleaner" />
      <Pricing357Li disabled text="Extra testing" />
      <Pricing357Li disabled text="Certificate" />
    </Pricing357Item>
    <Pricing357Item
      title="Full Service"
      desc="A lot of value"
      price="$4,997"
      rate="/year"
      href="/contact"
      ariaLabel=""
      buttonText="Get Started"
    >
      <Pricing357Li text="All available starter feature" />
      <Pricing357Li text="Home service 24/7" />
      <Pricing357Li text="Customer agent service" />
      <Pricing357Li text="Professional cleaner" />
      <Pricing357Li text="Extra testing" />
      <Pricing357Li text="Certificate" />
    </Pricing357Item>
  </Pricing357>
</Pricing357Section>
