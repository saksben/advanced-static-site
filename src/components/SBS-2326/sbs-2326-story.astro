---
import { cn } from "@utils/utils";
import Sbs2326 from "./sbs-2326.astro";
import Sbs2326Li from "./sbs-2326-li.astro";
import Text from "@components/ContentFlair/Toppers/Text/text.astro";
import CsButton1 from "@components/Buttons/Button-1/cs-button-1.astro";
import {} from "@assets/index";
import { images } from "assets"; // Demo images, remove from final site and replace with src images
import client from "@data/client.json"

interface Props {}

const {} = Astro.props;

const niche = client.industry.service.toLowerCase();

// Styles
const button = "";
---

<Sbs2326
  topper="About Us"
  title="Creating Elegant Environments, One Detail At A Time"
  tag="What Sets Us Apart"
  alt1=""
  alt2=""
  src1={images[niche].about1}
  src2={images[niche].about2}
  phone={client.phoneFormatted}
  phoneHref={client.phoneForTel}
  phoneText="Need Help?"
  email="Click To Email"
  emailHref={client.email}
  emailText="Email Us"
>
  <Text
    slot="text"
    text=`Since 2014, ${client.name} has been a trusted name in ${client.address.city}, ${client.address.stateFull}. With a rich history of completing over 500 diverse projects, we’ve built a reputation for reliability, innovation, and excellence.`
  />
  <CsButton1
    slot="button"
    href=""
    ariaLabel=""
    text="Book an Appointment"
    className={cn(button)}
  />
  <Sbs2326Li slot="li" text="Over 15 years of experience." />
  <Sbs2326Li
    slot="li"
    text="Expertise in bespoke builds and high-end renovations."
  />
  <Sbs2326Li
    slot="li"
    text="A proven track record of success in projects of all scales."
  />
</Sbs2326>
