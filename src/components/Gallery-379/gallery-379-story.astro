---
import SectionHeader from "@components/ContentFlair/Toppers/SectionHeader/SectionHeader.astro";
import { cn, pluralize } from "@utils/utils";
import Gallery379 from "./gallery-379.astro";
import Gallery379Img from "./gallery-379-img.astro";
import client from "@data/client.json"
import { images } from "@assets/index";

interface Props {}

const {} = Astro.props;

const niche = client.industry.service.toLowerCase();

// Styles
const container = "max-w-[59.6875rem]";
---

<SectionHeader
  sectionId="gallery-379"
  topper="Our Portfolio"
  title="Some Work from Our Memorable Gallery"
  text=`At ${client.name}, let us help you solve problems so that you can ${client.industry.sector === "residential" ? "have peace of mind" : "focus on your mission"}. We support ${pluralize(client.industry.entity)} through periods of entry and expansion.`
  contentAlign="center"
  containerStyles={cn(container)}
  topperStyles="dark:text-primaryLight"
>
  <Gallery379>
    <Gallery379Img
      src={images[niche].port1}
    />
    <Gallery379Img
      src={images[niche].port2}
    />
    <Gallery379Img
      src={images[niche].port3}
    />
    <Gallery379Img
      src={images[niche].port4}
    />
    <Gallery379Img
      src={images[niche].port5}
    />
    <Gallery379Img
      src={images[niche].port6}
    />
  </Gallery379>
</SectionHeader>
