---
import SectionHeader from "@components/ContentFlair/Toppers/SectionHeader/SectionHeader.astro";
import { cn } from "@utils/utils";
import Gallery379 from "./gallery-379.astro";
import Gallery379Img from "./gallery-379-img.astro";
import client from "@data/client.json"
import { Port1, Port2, Port4, Port5, Port7, Port8 } from "@assets/index";

interface Props {}

const {} = Astro.props;

// Styles
const container = "max-w-[59.6875rem]";
---

<SectionHeader
  sectionId="gallery-379"
  topper="Our Portfolio"
  title="Some Work from Our Memorable Gallery"
  text=`At ${client.name}, let us help you solve problems so that you can focus on your mission. We support businesses through periods of expansion, succession.`
  contentAlign="center"
  containerStyles={cn(container)}
  topperStyles="dark:text-primaryLight"
>
  <Gallery379>
    <Gallery379Img
      src={Port1}
    />
    <Gallery379Img
      src={Port4}
    />
    <Gallery379Img
      src={Port7}
    />
    <Gallery379Img
      src={Port2}
    />
    <Gallery379Img
      src={Port5}
    />
    <Gallery379Img
      src={Port8}
    />
  </Gallery379>
</SectionHeader>
