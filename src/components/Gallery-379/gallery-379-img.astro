---
import Picture from "@components/ContentFlair/Picture/picture.astro";
import { cn } from "@utils/utils";

interface Props {
  src: ImageMetadata;
  alt?: string;
  width?: string;
  height?: string;
}

const { src, alt = "gallery", width = "305", height = "400" } = Astro.props;

// Styles
const image =
  "rounded-[1.25rem] w-[46%] h-[clamp(9.375rem,_39vw,_18.75rem)] max-w-[21.875rem] overflow-hidden block relative md:w-[32.8%] md:max-w-[19.0625rem] md:h-[clamp(18.75rem,_30vw,_25rem)] md:aspect-1]";
const img = "absolute top-0 left-0 h-full w-full object-cover";
---

<Picture
  className={cn(image)}
  imgClassName={cn(img)}
  src={src}
  alt={alt}
  width={width}
  height={height}
/>
