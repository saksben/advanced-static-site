---
import { cn, pluralize } from "@utils/utils";
import Faq1466 from "./faq-1466.astro";
import Section from "@components/ContentFlair/Toppers/Section/section.astro";
import Container from "@components/ContentFlair/Toppers/Container/container.astro";
import Content from "@components/ContentFlair/Toppers/Content/content.astro";
import Topper from "@components/ContentFlair/Toppers/Topper/topper.astro";
import Title from "@components/ContentFlair/Toppers/Title/title.astro";
import Faq1466Li from "./faq-1466-li.astro";
import Picture from "@components/ContentFlair/Picture/picture.astro";
import { images } from "@assets/index";
import client from "@data/client.json"

interface Props {}

const {} = Astro.props;

const niche = client.industry.service.toLowerCase();

// Styles
const section = "relative overflow-hidden";
const container = "justify-center gap-[clamp(3rem,_8vw,_6.75rem)] md:max-w-[80rem] md:flex-row md:justify-between md:items-stretch";
const picture = "w-full h-[clamp(18.75rem,_65vw,_31.125rem)] block relative md:h-auto md:min-h-[42.375rem] md:order-1";
const img = "absolute top-0 left-0 h-full w-full object-cover rounded-[1.5rem]";
const content = "max-w-[39.375rem] md:w-[45vw] md:flex-none md:self-center";
const topper = "";
const title = "mb-8 max-w-[20ch]";
---

<Section id="faq-1466" className={cn(section)}>
  <Container maxWidth="39.375rem" className={cn(container)}>
    <Picture
      alt=""
      width="522"
      height="609"
      src={images[niche].faq}
      className={cn(picture)}
      imgClassName={cn(img)}
    />
    <Content className={cn(content)}>
      <Topper className={cn(topper)} topper="Asked Questions" />
      <Title className={cn(title)} title="Frequently Asked Questions" />
      <Faq1466>
        <Faq1466Li
          title="How soon can you start my project?"
          text="Timelines depend on the project size and current scheduling, but most jobs begin within a week of approval. We’ll give you a clear start date before you commit."
        />
        <Faq1466Li
          title="Do you provide free estimates?"
          text="Yes — every project starts with a no-obligation quote. You’ll get transparent pricing and clear next steps before any work begins."
        />
        <Faq1466Li
          title="Are you licensed and insured?"
          text="Absolutely. Our team is fully licensed, bonded, and insured, giving you peace of mind knowing your property and investment are protected."
        />
        <Faq1466Li
          title="What if I need changes during the project?"
          text="No problem. We keep you in the loop through every stage, and any adjustments are confirmed before implementation to ensure full satisfaction."
        />
        <Faq1466Li
          title=`What makes you different from other ${pluralize(client.industry.profession)} in ${client.address.city}?`
          text="We combine local expertise, professional standards, and modern tools to deliver work that’s efficient, durable, and customer-first. When you hire us, you’re getting accountability and quality you can see."
        />
      </Faq1466>
    </Content>
  </Container>
</Section>
