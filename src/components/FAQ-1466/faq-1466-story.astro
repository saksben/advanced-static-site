---
import { cn } from "@utils/utils";
import Faq1466 from "./faq-1466.astro";
import Section from "@components/ContentFlair/Toppers/Section/section.astro";
import Container from "@components/ContentFlair/Toppers/Container/container.astro";
import Content from "@components/ContentFlair/Toppers/Content/content.astro";
import Topper from "@components/ContentFlair/Toppers/Topper/topper.astro";
import Title from "@components/ContentFlair/Toppers/Title/title.astro";
import Faq1466Li from "./faq-1466-li.astro";
import Picture from "@components/ContentFlair/Picture/picture.astro";
import { EnvironmentSlogan } from "@assets/index";

interface Props {}

const {} = Astro.props;

// Styles
const section = "relative overflow-hidden";
const container = "justify-center gap-[clamp(3rem,_8vw,_6.75rem)] md:max-w-[80rem] md:flex-row md:justify-between md:items-stretch";
const picture = "w-full h-[clamp(18.75rem,_65vw,_31.125rem)] block relative md:h-auto md:min-h-[42.375rem] md:order-1";
const img = "absolute top-0 left-0 h-full w-full object-cover rounded-[1.5rem]";
const content = "max-w-[39.375rem] md:w-[45vw] md:flex-none md:self-center";
const topper = "";
const title = "mb-8 max-w-[20ch]";
---

<Section id="faq-1466" className={cn(section)}>
  <Container maxWidth="39.375rem" className={cn(container)}>
    <Picture
      alt=""
      width="522"
      height="609"
      src={EnvironmentSlogan}
      className={cn(picture)}
      imgClassName={cn(img)}
    />
    <Content className={cn(content)}>
      <Topper className={cn(topper)} topper="Asked Questions" />
      <Title className={cn(title)} title="Frequently Asked Questions" />
      <Faq1466>
        <Faq1466Li
