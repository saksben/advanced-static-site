---
import { cn } from "@utils/utils";
import Sbs1308 from "./sbs-1308.astro";
import Sbs1308Li from "./sbs-1308-li.astro";
import Text from "@components/ContentFlair/Toppers/Text/text.astro";
import CsButton1 from "@components/Buttons/Button-1/cs-button-1.astro";
import { Tax1 } from "@assets/index";

interface Props {}

const {} = Astro.props;

// Styles
const button = "min-w-[9.375rem] box-border";
---

<Sbs1308
  topper="About Us"
  title="Get Help on Finance"
  tag="Accounting & support of your business"
  alt=""
  src={Tax1}
>
  <Text
    slot="content"
    text="In the new era of technology we look in the future with certainty and pride for our company and business. consider all the drivers of change gives you the blocks & pride for our components you need to change to create a truly professional website In the new era."
  />
  <CsButton1 slot="content" href="" ariaLabel="" text="Learn More" className={cn(button)} />
  <Sbs1308Li slot="item" number="150 +" text="Staff on three continents" />
  <Sbs1308Li slot="item" number="700 +" text="Consulting engagements" />
  <Sbs1308Li slot="item" number="180 +" text="Learning community members" />
</Sbs1308>
