---
import { cn } from "@utils/utils";

interface Props {
    number: string;
    text: string;
}

const {number, text} = Astro.props

// Styles
const item = "list-none w-[32%] flex flex-col self-stretch content-between"
const numberStyles = "text-[1.5625rem] leading-[1.2em] font-bold text-left text-primary block mb-2"
const h3 = "text-base leading-[1.5em] font-normal text-left m-0 text-bodyTextColor dark:text-bodyTextColorWhite dark:opacity-80"
---
<li class={cn(item)}>
    <span class={cn(numberStyles)}>{number}</span>
    <h3 class={cn(h3)}>{text}</h3>
</li>